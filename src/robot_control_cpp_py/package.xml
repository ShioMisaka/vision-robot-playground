<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_control_cpp_py</name>
  <version>0.1.0</version>
  <description>Python bindings for robot_control_cpp via pybind11</description>
  <maintainer email="user@example.com">ShioMisaka</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>robot_control_cpp</depend>

  <build_depend>pybind11-dev</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
